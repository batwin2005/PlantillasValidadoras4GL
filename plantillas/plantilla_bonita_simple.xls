<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">

 <Styles>
  <!-- Estilo por defecto -->
  <Style ss:ID="Default" ss:Name="Normal">
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#000000"/>
   <Alignment ss:Vertical="Bottom"/>
  </Style>

  <!-- TÃ­tulo principal -->
  <Style ss:ID="Titulo">
   <Font ss:FontName="Calibri" ss:Size="16" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#003366" ss:Pattern="Solid"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
  </Style>

  <!-- SubtÃ­tulo / banco -->
  <Style ss:ID="Subtitulo">
   <Font ss:FontName="Calibri" ss:Size="12" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#004080" ss:Pattern="Solid"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
  </Style>

  <!-- Encabezados de tabla -->
  <Style ss:ID="Header">
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#005599" ss:Pattern="Solid"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#003366"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#FFFFFF"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#FFFFFF"/>
   </Borders>
  </Style>

  <!-- Tags invisibles -->
  <Style ss:ID="Tag">
   <Font ss:FontName="Calibri" ss:Size="9" ss:Bold="1" ss:Italic="1" ss:Color="#003366"/>
   <Interior ss:Color="#E8F0FE" ss:Pattern="Solid"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
  </Style>

  <!-- Datos normales -->
  <Style ss:ID="Dato">
   <Font ss:FontName="Calibri" ss:Size="11"/>
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CCCCCC"/>
   </Borders>
  </Style>

  <!-- Datos alternados (filas pares) -->
  <Style ss:ID="DatoAlt">
   <Font ss:FontName="Calibri" ss:Size="11"/>
   <Interior ss:Color="#F5F8FC" ss:Pattern="Solid"/>
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CCCCCC"/>
   </Borders>
  </Style>

  <!-- Fecha -->
  <Style ss:ID="Date">
   <Font ss:FontName="Calibri" ss:Size="11"/>
   <NumberFormat ss:Format="DD/MM/YYYY"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CCCCCC"/>
   </Borders>
  </Style>

  <!-- Moneda -->
  <Style ss:ID="Money">
   <Font ss:FontName="Calibri" ss:Size="11"/>
   <NumberFormat ss:Format="#,##0.00"/>
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CCCCCC"/>
   </Borders>
  </Style>

  <!-- Etiqueta de campo -->
  <Style ss:ID="Label">
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#003366"/>
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
  </Style>

  <!-- Valor de campo -->
  <Style ss:ID="Value">
   <Font ss:FontName="Calibri" ss:Size="11"/>
   <Interior ss:Color="#F0F4F8" ss:Pattern="Solid"/>
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#003366"/>
   </Borders>
  </Style>

  <!-- Pie de pÃ¡gina -->
  <Style ss:ID="Footer">
   <Font ss:FontName="Calibri" ss:Size="9" ss:Italic="1" ss:Color="#666666"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
  </Style>
 </Styles>

 <!-- Hoja principal: Datos del cliente -->
 <Worksheet ss:Name="Datos">
  <Table>
   <Column ss:Width="30"/>
   <Column ss:Width="140"/>
   <Column ss:Width="30"/>
   <Column ss:Width="140"/>
   <Column ss:Width="30"/>
   <Column ss:Width="140"/>

   <!-- Fila 1: TÃ­tulo principal -->
   <Row ss:Height="35">
    <Cell ss:StyleID="Titulo" ss:MergeAcross="5"><Data ss:Type="String">BANCO DE LA NACIÃ“N ARGENTINA</Data></Cell>
   </Row>

   <!-- Fila 2: SubtÃ­tulo -->
   <Row ss:Height="25">
    <Cell ss:StyleID="Subtitulo" ss:MergeAcross="5"><Data ss:Type="String">Sistema de ValidaciÃ³n de Clientes</Data></Cell>
   </Row>

   <!-- Fila 3: Espacio -->
   <Row ss:Height="10"><Cell ss:MergeAcross="5"><Data ss:Type="String"></Data></Cell></Row>

   <!-- Fila 4: SecciÃ³n Datos Personales -->
   <Row ss:Height="22">
    <Cell ss:StyleID="Subtitulo" ss:MergeAcross="5"><Data ss:Type="String">DATOS PERSONALES</Data></Cell>
   </Row>

   <!-- Fila 5: Labels y Values -->
   <Row ss:Height="20">
    <Cell ss:StyleID="Label"><Data ss:Type="String">Tipo Doc:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{tipo_doc}}</Data></Cell>
    <Cell ss:StyleID="Label"><Data ss:Type="String">Nro Doc:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{num_doc}}</Data></Cell>
    <Cell ss:StyleID="Label"><Data ss:Type="String">GÃ©nero:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{genero}}</Data></Cell>
   </Row>

   <!-- Fila 6 -->
   <Row ss:Height="20">
    <Cell ss:StyleID="Label"><Data ss:Type="String">Apellidos:</Data></Cell>
    <Cell ss:StyleID="Value" ss:MergeAcross="3"><Data ss:Type="String">{{apellidos}}</Data></Cell>
    <Cell ss:StyleID="Label"><Data ss:Type="String">Estado Civil:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{estado_civil}}</Data></Cell>
   </Row>

   <!-- Fila 7 -->
   <Row ss:Height="20">
    <Cell ss:StyleID="Label"><Data ss:Type="String">Nombres:</Data></Cell>
    <Cell ss:StyleID="Value" ss:MergeAcross="3"><Data ss:Type="String">{{nombres}}</Data></Cell>
    <Cell ss:StyleID="Label"><Data ss:Type="String">Fecha Nac:</Data></Cell>
    <Cell ss:StyleID="Value" ss:StyleID="Date"><Data ss:Type="String">{{fecha_nac}}</Data></Cell>
   </Row>

   <!-- Fila 8: Espacio -->
   <Row ss:Height="10"><Cell ss:MergeAcross="5"><Data ss:Type="String"></Data></Cell></Row>

   <!-- Fila 9: SecciÃ³n Contacto -->
   <Row ss:Height="22">
    <Cell ss:StyleID="Subtitulo" ss:MergeAcross="5"><Data ss:Type="String">DATOS DE CONTACTO</Data></Cell>
   </Row>

   <!-- Fila 10 -->
   <Row ss:Height="20">
    <Cell ss:StyleID="Label"><Data ss:Type="String">TelÃ©fono:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{telefono}}</Data></Cell>
    <Cell ss:StyleID="Label"><Data ss:Type="String">Celular:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{celular}}</Data></Cell>
    <Cell ss:StyleID="Label"><Data ss:Type="String">Email:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{email}}</Data></Cell>
   </Row>

   <!-- Fila 11 -->
   <Row ss:Height="20">
    <Cell ss:StyleID="Label"><Data ss:Type="String">DirecciÃ³n:</Data></Cell>
    <Cell ss:StyleID="Value" ss:MergeAcross="3"><Data ss:Type="String">{{direccion}}</Data></Cell>
    <Cell ss:StyleID="Label"><Data ss:Type="String">Ciudad:</Data></Cell>
    <Cell ss:StyleID="Value"><Data ss:Type="String">{{ciudad}}</Data></Cell>
   </Row>

   <!-- Fila 12: Espacio -->
   <Row ss:Height="15"><Cell ss:MergeAcross="5"><Data ss:Type="String"></Data></Cell></Row>

   <!-- Fila 13: Instrucciones -->
   <Row ss:Height="30">
    <Cell ss:StyleID="Footer" ss:MergeAcross="5"><Data ss:Type="String">Complete todos los campos obligatorios. Los datos serÃ¡n validados automÃ¡ticamente.</Data></Cell>
   </Row>
  </Table>

  <!-- Validaciones de datos -->
  <DataValidations xmlns="urn:schemas-microsoft-com:office:spreadsheet">
   <DataValidation xmlns="urn:schemas-microsoft-com:office:spreadsheet"
    Type="List" AllowBlank="false" ShowInputMessage="True" ShowErrorMessage="True"
    ErrorTitle="Valor invÃ¡lido" Error="Seleccione un tipo de documento vÃ¡lido"
    PromptTitle="Tipo de Documento" Prompt="Seleccione: DNI, LE, LC, PAS">
    <Formula1>"DNI,LE,LC,PAS"</Formula1>
    <CellRange>B5:B1000</CellRange>
   </DataValidation>
   <DataValidation xmlns="urn:schemas-microsoft-com:office:spreadsheet"
    Type="List" AllowBlank="false" ShowInputMessage="True" ShowErrorMessage="True"
    ErrorTitle="Valor invÃ¡lido" Error="Seleccione gÃ©nero"
    PromptTitle="GÃ©nero" Prompt="Seleccione: M, F, X">
    <Formula1>"M,F,X"</Formula1>
    <CellRange>F5:F1000</CellRange>
   </DataValidation>
   <DataValidation xmlns="urn:schemas-microsoft-com:office:spreadsheet"
    Type="Date" Operator="Between" AllowBlank="false" ShowInputMessage="True" ShowErrorMessage="True"
    ErrorTitle="Fecha invÃ¡lida" Error="Ingrese fecha entre 01/01/1900 y 31/12/2099"
    PromptTitle="Fecha Nacimiento" Prompt="Formato: DD/MM/YYYY">
    <Formula1>1900-01-01</Formula1>
    <Formula2>2099-12-31</Formula2>
    <CellRange>G7:G1000</CellRange>
   </DataValidation>
  </DataValidations>
 </Worksheet>

 <!-- Hoja de Lote: MÃºltiples registros -->
 <Worksheet ss:Name="Lote">
  <Table>
   <Column ss:Width="100"/>
   <Column ss:Width="120"/>
   <Column ss:Width="100"/>
   <Column ss:Width="100"/>
   <Column ss:Width="100"/>
   <Column ss:Width="120"/>
   <Column ss:Width="120"/>

   <!-- Encabezados -->
   <Row ss:Height="25">
    <Cell ss:StyleID="Header"><Data ss:Type="String">Tipo Doc</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Nro Documento</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Apellidos</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Nombres</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">GÃ©nero</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Fecha Nac</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Email</Data></Cell>
   </Row>

   <!-- Tags -->
   <Row ss:Height="18">
    <Cell ss:StyleID="Tag"><Data ss:Type="String">{{tipo_doc}}</Data></Cell>
    <Cell ss:StyleID="Tag"><Data ss:Type="String">{{num_doc}}</Data></Cell>
    <Cell ss:StyleID="Tag"><Data ss:Type="String">{{apellidos}}</Data></Cell>
    <Cell ss:StyleID="Tag"><Data ss:Type="String">{{nombres}}</Data></Cell>
    <Cell ss:StyleID="Tag"><Data ss:Type="String">{{genero}}</Data></Cell>
    <Cell ss:StyleID="Tag"><Data ss:Type="String">{{fecha_nac}}</Data></Cell>
    <Cell ss:StyleID="Tag"><Data ss:Type="String">{{email}}</Data></Cell>
   </Row>

   <!-- Datos de ejemplo -->
   <Row>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">DNI</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">30123456</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">PEREZ</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">JUAN CARLOS</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">M</Data></Cell>
    <Cell ss:StyleID="Dato" ss:StyleID="Date"><Data ss:Type="String">15/03/1985</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">juan.perez@email.com</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">DNI</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">30789012</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">GARCIA</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">MARIA ELENA</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">F</Data></Cell>
    <Cell ss:StyleID="DatoAlt" ss:StyleID="Date"><Data ss:Type="String">22/07/1990</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">maria.garcia@email.com</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">LE</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">20456789</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">LOPEZ</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">CARLOS ALBERTO</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">M</Data></Cell>
    <Cell ss:StyleID="Dato" ss:StyleID="Date"><Data ss:Type="String">10/11/1978</Data></Cell>
    <Cell ss:StyleID="Dato"><Data ss:Type="String">carlos.lopez@email.com</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">PAS</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">P1234567</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">MARTINEZ</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">ANA MARIA</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">F</Data></Cell>
    <Cell ss:StyleID="DatoAlt" ss:StyleID="Date"><Data ss:Type="String">05/05/1995</Data></Cell>
    <Cell ss:StyleID="DatoAlt"><Data ss:Type="String">ana.martinez@email.com</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- Hoja de Listas para validaciones -->
 <Worksheet ss:Name="Listas">
  <Table>
   <Row ss:Height="20">
    <Cell ss:StyleID="Header"><Data ss:Type="String">Tipo Documento</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">GÃ©nero</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Estado Civil</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">DNI</Data></Cell>
    <Cell><Data ss:Type="String">M</Data></Cell>
    <Cell><Data ss:Type="String">S</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">LE</Data></Cell>
    <Cell><Data ss:Type="String">F</Data></Cell>
    <Cell><Data ss:Type="String">C</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">LC</Data></Cell>
    <Cell><Data ss:Type="String">X</Data></Cell>
    <Cell><Data ss:Type="String">D</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">PAS</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">V</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">U</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

</Workbook>