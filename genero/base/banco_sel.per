# ============================================================
# FORMULARIO: banco_sel.per
# Selección de banco y plantilla
# ============================================================

DATABASE banco

SCREEN RECORD banco_sel (
    v_idx_banco,
    v_idx_plant,
    banco_lista.*
)

LAYOUT
GRID
{
[banco_sel                                         ]
[ lbl_titulo                                       ]
[                                                  ]
[ Bancos y Plantillas:                             ]
[ [banco_lista                           ]         ]
[                                                  ]
[ [seleccionar                       |cancelar    ] ]
}
END
END

ATTRIBUTES
TITLE = "Seleccionar Banco / Plantilla";
FORMONLY.lbl_titulo = formonly.lbl_titulo, NOENTRY, COLOR=BLUE, REVERSE;
FORMONLY.banco_lista = formonly.banco_lista, NOENTRY;
FORMONLY.v_idx_banco = formonly.v_idx_banco, NOENTRY;
FORMONLY.v_idx_plant = formonly.v_idx_plant, NOENTRY;
END

INSTRUCTIONS
ON ACTION seleccionar
    MESSAGE "Seleccionando..."
ON ACTION cancelar
    EXIT MENU
END