# ============================================================
# FORMULARIO: menu_validacion.per
# Menú principal del validador
# ============================================================

DATABASE banco

SCREEN RECORD main_menu (
    titulo,
    banco_lista.*
)

LAYOUT
GRID
{
[menu_validacion                                    ]
[ titulo                                            ]
[                                                   ]
[ 1. Seleccionar Banco/Plantilla                    ]
[ 2. Cargar Plantilla Master (XLS/XLSX)             ]
[ 3. Descargar Plantilla con Tags                   ]
[ 4. Cargar y Validar Datos                         ]
[ 5. Exportar Resultados                            ]
[                                                   ]
[ 0. Volver                                         ]
[                                                   ]
}
END
END

ATTRIBUTES
TITLE = "Plantillas Validadoras 4GL - Menú Principal";
FORMONLY.titulo = formonly.titulo, NOENTRY, COLOR=BLUE, REVERSE;
FORMONLY.banco_lista = formonly.banco_lista, NOENTRY;
END

INSTRUCTIONS
ON ACTION seleccionar
    MESSAGE "Seleccionar banco/plantilla"
ON ACTION cancelar
    EXIT MENU
END