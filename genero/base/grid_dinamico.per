-- ============================================================
-- FORMULARIO: grid_dinamico.per
-- Grid dinámico para mostrar resultados de queries
-- ============================================================

LAYOUT
GRID
{
[titulo                                                                             ]
[subtitulo                                                                          ]
--------------------------------------------------------------------------------------
[#resultados                                                                        ]
--------------------------------------------------------------------------------------
[total_filas       ][total_columnas     ][pagina            ]
[btn_exportar_csv  ][btn_exportar_excel ][btn_filtrar       ][btn_stats][btn_cerrar   ]
}
END
END LAYOUT

ATTRIBUTES
titulo     = FIELD(titulo_grid, NOENTRY, STYLE="titulo_grid");
subtitulo  = FIELD(subtitulo_grid, NOENTRY);

#resultados = SCREEN RECORD grid_datos(grid[1:500].*);

total_filas     = FIELD(num_filas, NOENTRY);
total_columnas  = FIELD(num_columnas, NOENTRY);
pagina          = FIELD(num_pagina, NOENTRY);

btn_exportar_csv   = BUTTON btn_exportar_csv, TEXT="Exportar CSV";
btn_exportar_excel = BUTTON btn_exportar_excel, TEXT="Exportar Excel";
btn_filtrar        = BUTTON btn_filtrar, TEXT="Filtrar";
btn_stats          = BUTTON btn_stats, TEXT="Estadisticas";
btn_cerrar         = BUTTON btn_cerrar, TEXT="Cerrar";

END ATTRIBUTES

INSTRUCTIONS
ON KEY (F5)  CALL grid_exportar_csv_desde_form()
ON KEY (F6)  CALL grid_exportar_excel_desde_form()
ON KEY (F7)  CALL grid_mostrar_filtros_desde_form()
ON KEY (F8)  CALL grid_mostrar_stats_desde_form()
ON KEY (F10) CALL salir_grid()
END INSTRUCTIONS
