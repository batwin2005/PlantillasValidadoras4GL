-- ============================================================
-- FORMULARIO: banco.per
-- Formulario de cliente bancario (sintaxis .per clásica)
-- ============================================================

LAYOUT
GRID
{
[cliente_id    ][tipo_doc    ][num_doc                      ]
[apellidos                                                                ]
[nombres                                                                  ]
[genero    ][fecha_nac    ][anio_emision    ]
[telefono                    ][celular                    ]
[email                                                                    ]
[estado_civil][direccion                                                  ]
[ciudad    ][ocupacion                                    ]
}
END
END LAYOUT

ATTRIBUTES
cliente_id      = FIELD(rec.cliente_id, DISPLAY ONLY, NOENTRY);
tipo_doc        = FIELD(rec.tipo_doc, REQUIRED, UPSHIFT,
                        COMBOBOX, ITEMS=(("DNI","DNI"),("LE","LE"),("LC","LC"),
                                         ("PAS","PAS"),("CI","CI"),("RUT","RUT"),("CIU","CIU")));
num_doc         = FIELD(rec.num_doc, REQUIRED, UPSHIFT, 
                        PICTURE="XXXXXXXXXXXXXXXXXXXX",
                        COMMENT="Número documento (5-20 alfanum)");
apellidos       = FIELD(rec.apellidos, REQUIRED, UPSHIFT,
                        COMMENT="Solo letras y espacios, 2-60 chars");
nombres         = FIELD(rec.nombres, REQUIRED, UPSHIFT,
                        COMMENT="Solo letras y espacios, 2-60 chars");
genero          = FIELD(rec.genero, REQUIRED, UPSHIFT,
                        COMBOBOX, ITEMS=(("M","Masculino"),("F","Femenino"),("X","Otro")));
fecha_nac       = FIELD(rec.fecha_nac, REQUIRED,
                        FORMAT="mm/dd/yyyy",
                        COMMENT="Formato MM/DD/YYYY, 1900-hoy");
anio_emision    = FIELD(rec.anio_emision, REQUIRED,
                        PICTURE="9999",
                        COMMENT="Año 1900-año actual");
telefono        = FIELD(rec.telefono,
                        PICTURE="XXXXXXXXXXXXXXXXXXXX",
                        COMMENT="Solo dígitos, + - ( ) espacios, 7-20");
celular         = FIELD(rec.celular,
                        PICTURE="XXXXXXXXXXXXXXXXXXXX",
                        COMMENT="Solo dígitos, + - ( ) espacios, 7-20");
email           = FIELD(rec.email,
                        COMMENT="Formato email válido (opcional)");
estado_civil    = FIELD(rec.estado_civil, UPSHIFT,
                        COMBOBOX, ITEMS=(("S","Soltero/a"),("C","Casado/a"),
                                         ("D","Divorciado/a"),("V","Viudo/a"),
                                         ("U","Unión convivencial")));
direccion       = FIELD(rec.direccion, REQUIRED,
                        COMMENT="Dirección completa");
ciudad          = FIELD(rec.ciudad, REQUIRED, UPSHIFT,
                        COMBOBOX, ITEMS=(("CABA","CABA"),("CORD","Córdoba"),
                                         ("ROS","Rosario"),("MEND","Mendoza"),
                                         ("LPLT","La Plata"),("TUC","Tucumán"),
                                         ("SAL","Salta"),("MVD","Montevideo"),
                                         ("SCL","Santiago"),("SPA","São Paulo")));
ocupacion       = FIELD(rec.ocupacion,
                        COMMENT="Ocupación/Profesión");
END ATTRIBUTES

INSTRUCTIONS
ON KEY (F1)  CALL ayuda_contexto()
ON KEY (F2)  CALL limpiar_campos()
ON KEY (F3)  CALL buscar_cliente()
ON KEY (F5)  CALL guardar_cliente()
ON KEY (F10) CALL salir_formulario()
END INSTRUCTIONS