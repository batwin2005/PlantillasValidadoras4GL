# ============================================================
# FORMULARIO: validar_datos.per
# Cargar y validar archivo con datos
# ============================================================

DATABASE banco

SCREEN RECORD validar_rec (
    archivo_datos,
    lbl_plantilla,
    lbl_maestra
)

LAYOUT
GRID
{
[validar_datos                                     ]
[ lbl_titulo                                       ]
[                                                  ]
[ Plantilla:      [lbl_plantilla                ] ]
[ Maestra:        [lbl_maestra                  ] ]
[                                                  ]
[ Archivo Datos:  [archivo_datos            |examinar] ]
[                                                  ]
[ [validar                      |cancelar      ] ]
}
END
END

ATTRIBUTES
TITLE = "Cargar y Validar Datos";
FORMONLY.lbl_titulo = formonly.lbl_titulo, NOENTRY, COLOR=BLUE, REVERSE;
FORMONLY.lbl_plantilla = formonly.lbl_plantilla, NOENTRY;
FORMONLY.lbl_maestra = formonly.lbl_maestra, NOENTRY;
FORMONLY.archivo_datos = formonly.archivo_datos;
END

INSTRUCTIONS
ON ACTION examinar
    MESSAGE "Seleccionar archivo con datos..."
ON ACTION validar
    MESSAGE "Validando (doble capa: Excel + 4GL)..."
ON ACTION cancelar
    EXIT MENU
END